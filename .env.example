# Template for the local .env file. Copy to .env and fill in real values:
#
#   cp .env.example .env      # Linux / macOS
#   Copy-Item .env.example .env   # Windows PowerShell
#
# .env is git-ignored and must never be committed. docker compose reads it
# from the repository root automatically; the Go services do not load it by
# themselves — export the variables in the shell before running them.

# ---------------------------------------------------------------------------
# RabbitMQ (used by docker-compose.yml)
# ---------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---------------------------------------------------------------------------
# User Service (prefix USER_SERVICE_*)
# ---------------------------------------------------------------------------
# Mandatory: the service refuses to start without it. The database runs in
# Docker (docker compose up -d user-db); user-service applies its own
# migrations at startup, so no manual schema setup is needed.
USER_SERVICE_DB_DSN=host=127.0.0.1 port=5432 user=library password=library dbname=library_users sslmode=disable

# First librarian. Set both values on a fresh database, leave them empty in
# production after the first administrator exists.
USER_SERVICE_SEED_LIBRARIAN_EMAIL=
USER_SERVICE_SEED_LIBRARIAN_PASSWORD=

# Rate limiting (token bucket per method + global cap).
# Zero values use built-in defaults (login: 2 rps/4 burst, register: 1/2,
# change-password: 2/4, global: 100/200).
USER_SERVICE_RATE_LOGIN_RPS=0
USER_SERVICE_RATE_LOGIN_BURST=0
USER_SERVICE_RATE_REGISTER_RPS=0
USER_SERVICE_RATE_REGISTER_BURST=0
USER_SERVICE_RATE_CHANGE_PASSWORD_RPS=0
USER_SERVICE_RATE_CHANGE_PASSWORD_BURST=0
USER_SERVICE_RATE_GLOBAL_RPS=0
USER_SERVICE_RATE_GLOBAL_BURST=0

# ---------------------------------------------------------------------------
# n8n admin login (for UI at http://localhost:5679)
# ---------------------------------------------------------------------------
N8N_LOGIN_EMAIL=
N8N_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Book Service (prefix BOOK_SERVICE_*)
# ---------------------------------------------------------------------------
# Book Service still uses the in-memory repository; a PostgreSQL DSN appears
# here when its storage is switched (issue #9). The book-db container is
# already provisioned by docker-compose.yml as preparation.
BOOK_SERVICE_DB_USER=library
BOOK_SERVICE_DB_PASSWORD=library
BOOK_SERVICE_DB_NAME=library_books

# ---------------------------------------------------------------------------
# AI Service (prefix AI_*)
# ---------------------------------------------------------------------------
# The Go adapter of the AI recommendation service (ADR-0002). It talks to
# user-service and book-service over gRPC, to the RAG workflow (n8n) over
# HTTP, and to the pgvector store (ai-rag-db) over the pgx driver.
#
# The consumer is enabled by default; set AI_CONSUMER_ENABLED=false to
# disable the background catalog-sync worker.
AI_GRPC_ADDR=:8085
AI_HTTP_ADDR=:8095
AI_LOG_LEVEL=info
AI_LOG_FORMAT=json

# gRPC endpoints of upstream services — mandatory.
AI_CATALOG_GRPC_ADDR=book-service:8081
AI_USER_GRPC_ADDR=user-service:8082

# RAG workflow (n8n) — the only source of recommendation answers.
#
# For local dev (AI service on host): http://host.docker.internal:5678
# Inside Docker Compose: http://n8n:5678
#
# IMPORTANT: the dev workflow (auto-imported into n8n container) has webhook
# authentication disabled (authentication:none). In production, re-enable it and
# set AI_N8N_HEADER_VALUE to the matching header secret.
#
# To switch from Gemini to OpenAI: the dev workflow ships two disconnected
# "spare" nodes (Embeddings OpenAI + Chat Model OpenAI). In the n8n UI at
# http://localhost:5679, disconnect the Gemini nodes and connect the OpenAI
# ones in their place. Both emit/consume 3072-dim vectors.
AI_N8N_BASE_URL=http://n8n:5678
AI_N8N_HEADER_NAME=x-book-rag-key
AI_N8N_HEADER_VALUE=

# pgvector store — mandatory. Inside Docker Compose the host is the
# service name of ai-rag-db, published on :5433.
AI_RAG_STORE_DSN=host=ai-rag-db port=5432 user=${AI_RAG_DB_USER:-bookrag} password=${AI_RAG_DB_PASSWORD:-bookrag} dbname=${AI_RAG_DB_NAME:-bookrag} sslmode=disable

# Optional: direct embeddings for the standalone retrieval path.
# When empty the service answers from the n8n agent only.
AI_EMBEDDINGS_BASE_URL=
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=gemini-embedding-001
AI_EMBEDDINGS_DIMENSIONS=3072

# Catalog consumer (RabbitMQ). Defaults to the platform broker.
AI_CONSUMER_ENABLED=true
AI_RABBITMQ_URL=
AI_RABBITMQ_EXCHANGE=
