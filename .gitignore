# Editor / workspace files
*.code-workspace

# Build output of the services (go build -o bin/...).
# Exception: tools/protoc/bin/protoc.exe is a vendored tool and stays tracked;
# git keeps already-tracked files regardless of this rule.
bin/

# Binaries produced by the local Go toolchain.
*.exe

# Local run logs captured when starting the services.
*.log

# Coverage output (go test -coverprofile=coverage.txt, see .github/workflows/ci.yml).
coverage.txt

# Environment overrides (machine-specific secrets, never committed).
# .env.example is a tracked template and must stay in the repository.
.env
.env.local
*.env
!.env.example

