# Secrets and local state — never commit these
.env
*.env.local

# Local database dumps / exports
*.dump
*.sql.gz
dumps/

# Generated eval reports. The suite and the fixtures ARE committed; a run is an
# artifact of this machine (it embeds machine timings and API answers), so it is not.
evals/results/
!evals/results/.gitkeep

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
