      ],
      "default": "ROLE_UNSPECIFIED",
      "description": "Role of a user, ordered by growing privileges.\n\n - ROLE_READER: Reader: borrows books, manages only own account.\n - ROLE_LIBRARIAN: Librarian: manages the catalog and the accounts of readers."
    },
    "v1Session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "accessToken": {
          "type": "string",
          "description": "Bearer token, send it as 'authorization: Bearer \u003ctoken\u003e'."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Session opened by Login. The token is returned once and stored as a hash."
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/v1Role"
        },
        "status": {
          "$ref": "#/definitions/v1UserStatus"
        },
        "phone": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last successful sign in, absent while the account never signed in."
        }
      },
      "description": "Account of a reader or a librarian. A password is never returned."
    },
    "v1UserStatus": {
      "type": "string",
      "enum": [
        "USER_STATUS_UNSPECIFIED",
        "USER_STATUS_ACTIVE",
        "USER_STATUS_DEACTIVATED"
      ],
      "default": "USER_STATUS_UNSPECIFIED",
      "description": "Lifecycle state of an account.\n\n - USER_STATUS_ACTIVE: The account may sign in.\n - USER_STATUS_DEACTIVATED: Blocked by a librarian: signing in is refused, the data is kept."
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Session token returned by Login, sent as 'Bearer \u003ctoken\u003e'.",
      "name": "authorization",
      "in": "header"
    }
  }
}
