{
  "swagger": "2.0",
  "info": {
    "title": "API Gateway",
    "description": "Single HTTP entry point for the Smart Library platform. Routes requests to Book Service and User Service over gRPC. Authentication is handled via Bearer token; role-based access control restricts librarian operations.",
    "version": "1.0",
    "contact": {
      "name": "Smart Library"
    }
  },
  "tags": [
    {
      "name": "GatewayService",
      "description": "GatewayService aggregates the REST API of book-service and user-service\nbehind a single HTTP endpoint (:8080). Every RPC delegates to the\ncorresponding backend gRPC client after authentication and authorization.\n\n---- user-service: public ----"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
